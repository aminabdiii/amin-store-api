{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "buildCommand": "pnpm db:generate && pnpm build:vercel && pnpm db:deploy",
  "functions": {
    "api/index.mjs": {
      "includeFiles": "{dist-vercel/**,node_modules/.pnpm/swagger-ui-dist@*/node_modules/swagger-ui-dist/**}"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }]
}
