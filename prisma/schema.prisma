generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PLACED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum MovementType {
  ADJUSTMENT
  SALE
  CANCELLATION
}

model User {
  id           String              @id @default(uuid()) @db.Uuid
  email        String              @unique @db.VarChar(254)
  username     String              @unique @db.VarChar(100)
  fullName     String              @db.VarChar(200)
  passwordHash String
  role         Role                @default(CUSTOMER)
  active       Boolean             @default(true)
  avatarId     String?             @db.Uuid
  avatar       Media?              @relation("Avatar", fields: [avatarId], references: [id], onDelete: SetNull)
  createdAt    DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime            @updatedAt @db.Timestamptz(3)
  sessions     Session[]
  cart         Cart?
  orders       Order[]
  reviews      Review[]
  uploads      Media[]             @relation("Uploader")
  movements    InventoryMovement[]

  @@index([avatarId])
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  familyId  String    @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @db.Char(64)
  expiresAt DateTime  @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

model Media {
  id         String         @id @default(uuid()) @db.Uuid
  filename   String         @unique
  mimeType   String
  size       Int
  legacyPath String?        @unique
  uploaderId String?        @db.Uuid
  uploader   User?          @relation("Uploader", fields: [uploaderId], references: [id], onDelete: SetNull)
  createdAt  DateTime       @default(now()) @db.Timestamptz(3)
  avatars    User[]         @relation("Avatar")
  images     ProductImage[]
  categories Category[]
  articles   Article[]
  brands     Brand[]
  features   Feature[]

  @@index([uploaderId])
}

model Category {
  id        Int       @id @default(autoincrement())
  title     String    @db.VarChar(200)
  slug      String    @unique @db.VarChar(200)
  imageId   String?   @db.Uuid
  image     Media?    @relation(fields: [imageId], references: [id], onDelete: SetNull)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  products  Product[]

  @@index([imageId])
}

model Product {
  id               Int              @id @default(autoincrement())
  title            String           @db.VarChar(250)
  description      String           @default("")
  categoryId       Int
  category         Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  price            Decimal          @db.Decimal(20, 2)
  discount         Int              @default(0)
  shippingLeadDays Int              @default(1)
  isPreSale        Boolean          @default(false)
  saleEnabled      Boolean          @default(true)
  archivedAt       DateTime?        @db.Timestamptz(3)
  views            Int              @default(0)
  rating           Decimal          @default(0) @db.Decimal(3, 2)
  createdAt        DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @db.Timestamptz(3)
  images           ProductImage[]
  optionGroups     OptionGroup[]
  variants         ProductVariant[]
  reviews          Review[]
  orderItems       OrderItem[]

  @@index([categoryId, createdAt, id])
  @@index([archivedAt, price, id])
  @@index([archivedAt, rating, id])
  @@index([archivedAt, views, id])
  @@index([archivedAt, createdAt, id])
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  mediaId   String  @db.Uuid
  media     Media   @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  position  Int

  @@unique([productId, position])
  @@index([mediaId])
}

model OptionGroup {
  id        Int           @id @default(autoincrement())
  productId Int
  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String        @db.VarChar(100)
  values    OptionValue[]

  @@unique([productId, name])
}

model OptionValue {
  id         Int            @id @default(autoincrement())
  groupId    Int
  group      OptionGroup    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  value      String         @db.VarChar(150)
  selections VariantValue[]

  @@unique([groupId, value])
}

model ProductVariant {
  id         Int                 @id @default(autoincrement())
  productId  Int
  product    Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  signature  String
  stock      Int                 @default(0)
  values     VariantValue[]
  cartItems  CartItem[]
  orderItems OrderItem[]
  movements  InventoryMovement[]

  @@unique([productId, signature])
  @@index([productId, stock])
}

model VariantValue {
  variantId Int
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  valueId   Int
  value     OptionValue    @relation(fields: [valueId], references: [id], onDelete: Restrict)

  @@id([variantId, valueId])
  @@index([valueId])
}

model Cart {
  id                 Int        @id @default(autoincrement())
  userId             String     @unique @db.Uuid
  user               User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  requiresResolution Boolean    @default(false)
  items              CartItem[]
}

model CartItem {
  id        Int            @id @default(autoincrement())
  cartId    Int
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId Int
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  quantity  Int

  @@unique([cartId, variantId])
  @@index([variantId])
}

model Order {
  id               Int                 @id @default(autoincrement())
  userId           String?             @db.Uuid
  user             User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  legacyUserId     String?
  legacy           Boolean             @default(false)
  inventoryDebited Boolean             @default(false)
  idempotencyKey   String?             @db.VarChar(100)
  status           OrderStatus         @default(PLACED)
  currency         String              @default("USD") @db.Char(3)
  total            Decimal             @db.Decimal(20, 2)
  deliveryDate     DateTime?           @db.Date
  createdAt        DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime            @updatedAt @db.Timestamptz(3)
  items            OrderItem[]
  movements        InventoryMovement[]

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt, id])
  @@index([createdAt, id])
  @@index([status, createdAt])
}

model OrderItem {
  id           Int                  @id @default(autoincrement())
  orderId      Int
  order        Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    Int?
  product      Product?             @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId    Int?
  variant      ProductVariant?      @relation(fields: [variantId], references: [id], onDelete: SetNull)
  title        String
  imageUrl     String?
  unitPrice    Decimal              @db.Decimal(20, 2)
  discount     Int
  netUnitPrice Decimal              @db.Decimal(20, 2)
  quantity     Int
  selections   OrderItemSelection[]

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

model OrderItemSelection {
  id          Int       @id @default(autoincrement())
  orderItemId Int
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  name        String
  value       String

  @@unique([orderItemId, name])
}

model InventoryMovement {
  id        Int            @id @default(autoincrement())
  variantId Int
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  orderId   Int?
  order     Order?         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  actorId   String?        @db.Uuid
  actor     User?          @relation(fields: [actorId], references: [id], onDelete: SetNull)
  type      MovementType
  delta     Int
  reason    String
  createdAt DateTime       @default(now()) @db.Timestamptz(3)

  @@unique([orderId, variantId, type])
  @@index([variantId, createdAt])
  @@index([actorId])
}

model Review {
  id        Int      @id @default(autoincrement())
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  content   String
  rating    Int
  approved  Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([productId, approved, createdAt])
  @@index([userId])
}

model Article {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  imageId   String?  @db.Uuid
  image     Media?   @relation(fields: [imageId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([imageId])
  @@index([createdAt, id])
}

model Faq {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
}

model Brand {
  id        Int      @id @default(autoincrement())
  title     String   @default("")
  imageId   String?  @db.Uuid
  image     Media?   @relation(fields: [imageId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([imageId])
}

model Feature {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  shadowColor String?
  imageId     String?  @db.Uuid
  image       Media?   @relation(fields: [imageId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@index([imageId])
}

model LegacyRecord {
  id          Int      @id @default(autoincrement())
  sourceTable String
  sourceId    String
  reason      String
  payload     Json
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@unique([sourceTable, sourceId])
}

model ImportRun {
  id          String   @id @default(uuid()) @db.Uuid
  sourceHash  String   @unique
  completedAt DateTime @default(now()) @db.Timestamptz(3)
  report      Json
}
