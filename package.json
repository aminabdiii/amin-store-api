{
  "name": "amin-store-api",
  "version": "1.0.0",
  "private": true,
  "description": "Amin Store local REST API",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "dev": "ts-node src/main.ts",
    "build": "pnpm clean && tsc -p tsconfig.json",
    "start": "node dist/src/main.js",
    "typecheck": "tsc --noEmit",
    "format": "eslint src --fix --fix-type layout && prettier --write .",
    "format:check": "eslint src && prettier --check .",
    "lint": "eslint src test scripts --no-error-on-unmatched-pattern",
    "test": "pnpm build && node --test --test-concurrency=1 dist/test/*.test.js",
    "db:generate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:up": "docker compose up -d --wait postgres",
    "import:legacy": "ts-node scripts/import-legacy.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "db:migrate": "prisma migrate dev",
    "db:migrate:create": "prisma migrate dev --create-only",
    "db:status": "prisma migrate status",
    "db:studio": "prisma studio",
    "db:validate": "prisma validate",
    "db:format": "prisma format"
  },
  "dependencies": {
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/swagger": "^12.0.0",
    "@prisma/client": "7.10.1",
    "@prisma/adapter-pg": "7.10.1",
    "argon2": "^0.44.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^17.2.3",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sanitize-html": "^2.17.0",
    "sharp": "^0.34.4",
    "yauzl": "^3.2.0",
    "@nestjs/platform-fastify": "12.3.2",
    "fastify": "5.12.7",
    "@fastify/helmet": "13.2.0",
    "@fastify/static": "10.1.8",
    "@fastify/multipart": "10.1.6",
    "@fastify/rate-limit": "11.2.1"
  },
  "devDependencies": {
    "@nestjs/testing": "12.3.2",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.6",
    "@types/sanitize-html": "^2.16.0",
    "@types/supertest": "^6.0.3",
    "@types/yauzl": "^2.10.3",
    "eslint": "^9.39.0",
    "typescript-eslint": "^8.46.3",
    "prisma": "7.10.1",
    "prettier": "^3.6.2",
    "supertest": "^7.1.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
